<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_purchase_method_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.purchase.method</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="102"/>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('app_settings_block')][@data-key='purchase']" position="inside">
                <h2>Method</h2>
                <div class="row mt16 o_settings_container" name="method_purchase_setting_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="activar_funcionalidades_compras_method">
                        <div class="o_setting_left_pane">
                            <field name="activar_funcionalidades_compras_method"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="activar_funcionalidades_compras_method" string="Funcionalidades de Compras (Method)"/>
                            <span class="fa fa-lg fa-building-o" title="Values set here are company-specific." aria-label="Values set here are company-specific." groups="base.group_multi_company" role="img"/>
                            <div class="text-muted">
                                Activa la visibilidad de las funcionalidades y campos de compras que Method desarrolle desde ahora en este módulo. Aún no controla ningún campo.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
