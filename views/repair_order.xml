<odoo>
    <record id="view_repair_order_form_inherit_configuration" model="ir.ui.view">
        <field name="name">repair.order.form.inherit.configuration</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="priority">5</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="attrs">{'invisible': [('hide_repair_description', '=', True)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="hide_repair_description" invisible="1"/>
                <field name="show_repair_usage_hours" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='schedule_date']" position="replace">
                <label for="fecha_rma"/>
                <div class="o_row">
                    <field name="fecha_rma" class="o_input_10ch"/>
                    <label for="schedule_date" class="oe_inline"/>
                    <field name="schedule_date" class="o_input_10ch"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_repair_order_tree_inherit_amount_fields" model="ir.ui.view">
        <field name="name">repair.order.tree.inherit.amount.fields</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='schedule_date']" position="before">
                <field name="fecha_rma" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="before">
                <field name="amount_untaxed" sum="Total Untaxed" optional="show"/>
                <field name="amount_total" sum="Total" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
