<odoo>
    <data>

        <!-- Heredar menú Ajustes para añadir grupo Administrador de Ventas -->
        <record id="base.menu_administration" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        </record>

        <!-- Mover "Configuración" al final del menú Reparaciones (después de
             Informes/Reportes/Costeo, que también usan sequence 10 por defecto) -->
        <record id="repair.repair_menu_config" model="ir.ui.menu">
            <field name="sequence">100</field>
        </record>

    </data>
</odoo>
