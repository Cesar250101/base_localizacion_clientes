<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_repairorder_servitk" inherit_id="repair.report_repairorder">
        <xpath expr="//t[@t-call='web.external_layout']" position="replace">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                <t t-set="currency" t-value="o.currency_id or o.company_id.currency_id"/>
                <div class="page repair-quotation">
                    <style>
                        /* El logo del layout estandar trae style="max-height:45px" inline,
                           por lo que se requiere !important para ampliarlo un 30% (58.5px). */
                        .header img[alt="Logo"] { max-height: 58.5px !important; }

                        .repair-quotation { font-family: "Helvetica Neue", Arial, sans-serif; color: #2f3542; font-size: 10px; line-height: 1.45; }

                        /* El .page del layout estandar agrega su propio margen superior; se
                           neutraliza para que el cuerpo quede pegado al header. */
                        .repair-quotation.page { margin-top: 0; padding-top: 0; }

                        .repair-quotation .doc-head { display: flex; align-items: flex-end; justify-content: space-between;
                            border-bottom: 3px solid #1f6feb; padding-bottom: 6px; margin: 0 0 12px; }
                        .repair-quotation .doc-title { font-size: 22px; font-weight: 700; color: #16324f; letter-spacing: .3px; margin: 0; }
                        .repair-quotation .doc-subtitle { font-size: 9px; color: #7b8794; text-transform: uppercase; letter-spacing: 1.6px; margin: 0 0 2px; }
                        .repair-quotation .doc-badge { background: #16324f; color: #fff; font-size: 14px; font-weight: 700;
                            padding: 5px 14px; border-radius: 4px; white-space: nowrap; }

                        .repair-quotation .block-title { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.4px;
                            color: #1f6feb; border-bottom: 1px solid #d6dde6; padding-bottom: 3px; margin: 0 0 5px; }

                        .repair-quotation .repair-table { width: 100%; border-collapse: collapse; }
                        .repair-quotation .repair-table th, .repair-quotation .repair-table td { border: 1px solid #d6dde6; padding: 6px 9px; vertical-align: top; }
                        .repair-quotation .repair-table th { font-size: 9px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px;
                            background: #16324f; color: #fff !important; border-color: #16324f; }
                        .repair-quotation .repair-table th * { color: #fff !important; }
                        .repair-quotation .repair-table tbody tr:nth-child(even) td { background: #fafbfc; }
                        .repair-quotation .repair-table .section td { background: #eaf1fb !important; color: #16324f; font-weight: 700;
                            text-transform: uppercase; font-size: 9px; letter-spacing: .8px; }

                        /* Bloques cliente/equipo compactos: menos padding y menos margen
                           inferior para dejar mas espacio a las lineas de detalle. */
                        .repair-quotation .customer-table { margin-bottom: 10px; }
                        .repair-quotation .customer-table td { padding: 3px 8px; }
                        .repair-quotation .customer-table .label { width: 17%; font-weight: 700; background: #f4f6f9 !important; color: #4a5568; }
                        /* El color se aplica tambien a los descendientes: t-field renderiza un
                           span que de otro modo hereda el color oscuro del tema y queda
                           ilegible sobre el fondo azul marino (caso Patente). */
                        .repair-quotation .customer-table .dark,
                        .repair-quotation .customer-table .dark * { background-color: transparent; color: #fff !important; }
                        .repair-quotation .customer-table .dark { background: #16324f !important; }
                        .repair-quotation .customer-table .dark.label { background: #16324f !important; }

                        .repair-quotation .repair-details { width: 100%; border-collapse: separate; border-spacing: 6px 0; margin: 0 0 12px; }
                        .repair-quotation .repair-details td { width: 25%; background: #f4f6f9; border-left: 3px solid #1f6feb;
                            border-radius: 3px; padding: 4px 8px; vertical-align: top; }
                        .repair-quotation .repair-details .k { display: block; font-size: 7.5px; font-weight: 700; text-transform: uppercase;
                            letter-spacing: 1px; color: #7b8794; margin-bottom: 1px; }
                        .repair-quotation .repair-details .v { font-size: 10px; font-weight: 600; color: #16324f; }

                        .repair-quotation .fleet-section { margin: 0 0 12px; }
                        .repair-quotation .fleet-section-title { background: #16324f; color: #fff; font-weight: 700; padding: 4px 10px;
                            text-transform: uppercase; font-size: 9px; letter-spacing: 1.2px; border-radius: 3px 3px 0 0; }
                        .repair-quotation .fleet-section td { width: 25%; padding: 3px 8px; }
                        .repair-quotation .fleet-section .k { display: block; font-size: 7.5px; font-weight: 700; text-transform: uppercase;
                            letter-spacing: .8px; color: #7b8794; margin-bottom: 1px; }

                        .repair-quotation .lines-table td { font-size: 10px; }
                        .repair-quotation .lines-table tbody tr td:first-child { font-weight: 600; color: #16324f; }

                        .repair-quotation .totals { width: 40%; margin-left: auto; margin-top: 16px; border-collapse: collapse; }
                        .repair-quotation .totals td { border: 1px solid #d6dde6; padding: 7px 10px; }
                        .repair-quotation .totals tr td:first-child { color: #4a5568; }
                        .repair-quotation .totals tr td:last-child { text-align: right; font-weight: 600; color: #16324f; }
                        /*
                            El fondo se marca !important igual que el color de texto: sin
                            eso, el tema de Odoo (que pinta las celdas con su propio fondo
                            claro) ganaba el fondo pero perdia el color, dejando el monto
                            del Total en blanco sobre blanco e ilegible.
                            Se declara background-color (no el shorthand) para que la regla
                            apunte exactamente a la propiedad en disputa.
                        */
                        .repair-quotation .totals .total td { font-weight: 700; font-size: 13px;
                            border-color: #16324f;
                            background-color: #16324f !important;
                            -webkit-print-color-adjust: exact; print-color-adjust: exact; }
                        /*
                            Los spans quedan transparentes: si tambien se les pintara el
                            fondo, el azul cubriria solo el ancho del texto en vez de la
                            celda completa.
                        */
                        .repair-quotation .totals .total td,
                        .repair-quotation .totals .total td * { color: #fff !important; }
                        .repair-quotation .totals .total td * { background-color: transparent !important; }

                        .repair-quotation .notes { margin-top: 16px; white-space: pre-line; font-size: 9px; line-height: 1.35; }
                        /*
                            o.description y o.quotation_notes son campos Html: el editor de
                            Odoo genera parrafos y listas con margenes propios (~10-16px c/u)
                            que, con varias lineas, inflan el bloque de notas y empujan el
                            resto del documento a una segunda hoja. Se comprime ese espaciado aqui.
                        */
                        .repair-quotation .notes p,
                        .repair-quotation .notes ul,
                        .repair-quotation .notes ol { margin: 0 0 2px; padding-left: 14px; }
                        .repair-quotation .notes li { margin: 0; padding: 0; }
                        .repair-quotation .bank-data { margin-top: 12px; background: #f4f6f9; border-left: 3px solid #1f6feb;
                            padding: 8px 12px; border-radius: 3px; font-size: 9px; }
                        .repair-quotation .terms-conditions { margin-top: 10px; padding-top: 8px; border-top: 1px solid #d6dde6;
                            font-size: 7.5px; line-height: 1.3; color: #7b8794; }

                        /*
                            Solo se protegen los bloques cortos, que se ven mal partidos
                            y siempre caben enteros en lo que queda de hoja.

                            Las notas NO llevan page-break-inside: avoid a proposito: al
                            ser un bloque unico con toda la descripcion, esa regla obligaba
                            a wkhtmltopdf a empujarlo completo a la hoja siguiente cuando no
                            entraba, dejando media pagina en blanco. Sin la regla, el texto
                            fluye y solo pasa a la segunda hoja lo que realmente no cabe.
                        */
                        .repair-quotation .bank-data,
                        .repair-quotation .terms-conditions,
                        .repair-quotation .totals { page-break-inside: avoid; }
                        /* Se evita cortar una fila de detalle por la mitad, pero no se
                           fuerza a la tabla completa a saltar de hoja. */
                        .repair-quotation .lines-table tr { page-break-inside: avoid; }
                        /* Las viñetas se parten individualmente, nunca a mitad de renglon. */
                        .repair-quotation .notes li { page-break-inside: avoid; }
                    </style>

                    <div class="doc-head">
                        <div>
                            <p class="doc-subtitle">Presupuesto de reparación</p>
                            <h1 class="doc-title">Orden de servicio</h1>
                        </div>
                        <div class="doc-badge"><span t-field="o.name"/></div>
                    </div>

                    <div class="block-title">Antecedentes del cliente</div>
                    <!--
                        La patente puede venir de la propia orden o, si no se cargo ahi,
                        del equipo o del vehiculo asociado. Se resuelve antes de la tabla
                        para que tambien este disponible en el bloque de notas.
                    -->
                    <t t-set="patente_doc" t-value="o.patente or (o.equipo_id and o.equipo_id.patente) or (o.fleet_vehicle_id and o.fleet_vehicle_id.license_plate)"/>
                    <table class="repair-table customer-table">
                        <tbody>
                            <tr>
                                <td class="label">Cliente</td>
                                <td><span t-field="o.partner_id"/></td>
                                <td class="label">Fecha</td>
                                <td><span t-field="o.fecha_rma"/></td>
                            </tr>
                            <tr>
                                <td class="label">Rut</td>
                                <td><span t-field="o.partner_id.vat"/></td>
                                <td class="label">Teléfono</td>
                                <td><span t-field="o.partner_id.phone"/></td>
                            </tr>
                            <tr>
                                <td class="label">Dirección</td>
                                <td><span t-esc="o.partner_id.contact_address"/></td>
                                <td class="label">Condición de Pago</td>
                                <td><span t-field="o.invoice_method"/></td>
                            </tr>
                            <tr t-if="patente_doc">
                                <td class="dark label">Patente</td>
                                <td class="dark" colspan="3"><span t-esc="patente_doc"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="repair-details">
                        <tbody>
                            <tr>
                                <td><span class="k">Unidad</span><span class="v" t-field="o.product_id"/></td>
                                <td><span class="k">Hora M / Hora T</span><span class="v" t-field="o.usage_hours"/></td>
                                <td><span class="k">Garantía</span><span class="v" t-field="o.guarantee_limit"/></td>
                                <td><span class="k">Fecha de impresión</span><span class="v" t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="fleet-section" t-if="o.show_repair_fleet_vehicle">
                        <div class="fleet-section-title">Datos del vehículo</div>
                        <table class="repair-table">
                            <tbody t-if="o.fleet_vehicle_id">
                                <tr>
                                    <td><span class="k">Vehículo</span><span t-field="o.fleet_vehicle_id"/></td>
                                    <td><span class="k">Patente</span><span t-field="o.fleet_vehicle_id.license_plate"/></td>
                                    <td><span class="k">Marca</span><span t-field="o.fleet_vehicle_id.brand_id"/></td>
                                    <td><span class="k">Modelo</span><span t-field="o.fleet_vehicle_id.model_id"/></td>
                                </tr>
                                <tr>
                                    <td><span class="k">Conductor</span><span t-field="o.fleet_vehicle_id.driver_id"/></td>
                                    <td><span class="k">Kilometraje</span><span t-field="o.fleet_vehicle_id.odometer"/> <span t-field="o.fleet_vehicle_id.odometer_unit"/></td>
                                    <td><span class="k">N° Chasis/VIN</span><span t-field="o.fleet_vehicle_id.vin_sn"/></td>
                                    <td><span class="k">Ubicación</span><span t-field="o.fleet_vehicle_id.location"/></td>
                                </tr>
                            </tbody>
                            <tbody t-else="">
                                <tr><td colspan="4">No se ha asociado un vehículo a esta orden de reparación.</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="fleet-section" t-if="o.show_repair_equipo">
                        <div class="fleet-section-title">Datos del equipo</div>
                        <table class="repair-table">
                            <tbody t-if="o.equipo_id">
                                <tr>
                                    <td><span class="k">Equipo</span><span t-field="o.equipo_id"/></td>
                                    <td><span class="k">Marca</span><span t-field="o.equipo_id.marca"/></td>
                                    <td><span class="k">Modelo</span><span t-field="o.equipo_id.modelo"/></td>
                                    <td><span class="k">Patente</span><span t-field="o.equipo_id.patente"/></td>
                                </tr>
                                <tr>
                                    <td><span class="k">Serie/Nro. Interno</span><span t-field="o.equipo_id.nro_serie"/></td>
                                    <td><span class="k">Horas/Kilometros</span><span t-field="o.equipo_id.hrs_km"/></td>
                                </tr>
                            </tbody>
                            <tbody t-else="">
                                <tr><td colspan="4">No se ha asociado un equipo a esta orden de reparación.</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="block-title">Detalle del presupuesto</div>
                    <table class="repair-table lines-table">
                        <thead>
                            <tr>
                                <th>Descripción</th>
                                <th class="text-end">Cantidad</th>
                                <th class="text-end">Unidad</th>
                                <th class="text-end">Precio de unidad</th>
                                <th class="text-end">Precio</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="o.operations">
                                <tr class="section"><td colspan="5">Repuestos</td></tr>
                                <tr t-foreach="o.operations" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                    <td class="text-end"><span t-field="line.product_uom"/></td>
                                    <td class="text-end"><span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                </tr>
                            </t>
                            <t t-if="o.fees_lines">
                                <tr class="section"><td colspan="5">Operaciones</td></tr>
                                <tr t-foreach="o.fees_lines" t-as="line">
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                    <td class="text-end"><span t-field="line.product_uom"/></td>
                                    <td class="text-end"><span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="text-end"><span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <table class="totals">
                        <tbody>
                            <tr><td><strong>Total Sin Impuestos</strong></td><td class="text-end"><span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": currency}'/></td></tr>
                            <tr><td>Impuestos</td><td class="text-end"><span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": currency}'/></td></tr>
                            <tr class="total"><td>Total</td><td class="text-end"><span t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": currency}'/></td></tr>
                        </tbody>
                    </table>

                    <!--
                        La patente ya se muestra en la tabla de antecedentes y el
                        usuario suele repetirla dentro de las notas, por lo que aqui
                        no se vuelve a imprimir.
                    -->
                    <div class="notes">
                        <div t-if="o.description"><span t-field="o.description"/></div>
                        <div t-if="o.quotation_notes" t-field="o.quotation_notes"/>
                    </div>
                    <div class="bank-data" t-if="o.company_id.partner_id.bank_ids">
                        <strong>Datos de Transferencia Bancaria</strong><br/>
                        <span t-field="o.company_id.partner_id.name"/> RUT: <span t-field="o.company_id.partner_id.vat"/>
                        <t t-set="bank" t-value="o.company_id.partner_id.bank_ids[0]"/>
                        <span> - </span><span t-field="bank.bank_id.name"/> CTA. CTE.: <span t-field="bank.acc_number"/>
                    </div>
                    <div class="terms-conditions" t-if="o.repair_terms_conditions">
                        <span t-field="o.repair_terms_conditions"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
