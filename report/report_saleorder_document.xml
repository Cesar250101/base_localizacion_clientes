<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_inherit_localizacion"
              inherit_id="sale.report_saleorder_document">

        <!-- NOTA DE COMPATIBILIDAD ENTRE BASES:
             La vista base sale.report_saleorder_document difiere entre clientes:
             en algunas es la estándar de Odoo (bloques <t t-set="address"> e
             <div id="informations"> activos) y en otras fue reescrita a mano y esos
             bloques quedaron comentados (no existen como nodos). Para que esta
             herencia cargue en TODAS las bases, aquí solo se usan anclas que existen
             en ambas variantes: o_main_table, sale_tbody, display_discount,
             th_description y td_name. No anclar a 'address' ni a 'informations'. -->

        <!-- Quitar bold en las líneas de la orden. El tamaño de letra ya no se
             fuerza aquí: se deja heredar el tamaño por defecto del layout de
             reporte, el mismo que usa el bloque 'address' (nombre del cliente),
             para que ambos queden visualmente igualados. -->
        <xpath expr="//table[contains(@class,'o_main_table')]" position="attributes">
            <attribute name="style">font-weight: normal; line-height: 1.2;</attribute>
        </xpath>
        <xpath expr="//tbody[@class='sale_tbody']" position="attributes">
            <attribute name="style">font-weight: normal; line-height: 1.2;</attribute>
        </xpath>

        <!-- Agregar el campo payment_term_id (Condición de Pago) encima de la tabla de
             líneas. Se ancla a o_main_table (presente en ambas variantes) en lugar del
             bloque 'informations', que está comentado en algunas bases. -->
        <xpath expr="//table[contains(@class,'o_main_table')]" position="before">
            <div t-if="doc.payment_term_id" class="col-auto col-3 mw-100 mb-2" name="payment_term">
                <strong>Condición de Pago:</strong>
                <p class="m-0" t-field="doc.payment_term_id"/>
            </div>
        </xpath>

        <!-- Cabecera: dos columnas de producto siempre visibles -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_sku" class="text-start">SKU</th>
        </xpath>
        <xpath expr="//th[@name='th_description']" position="replace">
            <th name="th_description" class="text-start">Producto</th>
        </xpath>

        <!-- Celdas: columna 1 = product.default_code, columna 2 = sale.order.line.name -->
        <xpath expr="//td[@name='td_name']" position="before">
            <td name="td_sku">
                <span t-field="line.product_id.default_code"/>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="replace">
            <td name="td_name"><span t-field="line.name"/></td>
        </xpath>

    </template>

    <!-- En la base clicksale la vista base sale.report_saleorder_document fue
         reescrita a mano y ya trae una columna "Producto" (th_producto/td_product_id
         con line.product_id.name) antes de Descripción, duplicando la información
         con las columnas SKU/Producto agregadas arriba. Esa columna NO existe en las
         demás bases (emsin, taller4, PosSuiteDemo, asvetec), así que este template
         debe permanecer inactivo por defecto (active="False") para no romper el xpath
         ahí. Se activa automáticamente solo donde corresponda vía
         models/ir_ui_view.py::_register_hook (comprueba si esos nombres existen en el
         arch de la vista base antes de activar esta herencia). -->
    <template id="report_saleorder_document_inherit_localizacion_legacy_producto"
              inherit_id="sale.report_saleorder_document" active="False">
        <xpath expr="//th[@name='th_producto']" position="replace"/>
        <xpath expr="//td[@name='td_product_id']" position="replace"/>
    </template>

    <!-- Herencias que SOLO aplican cuando la vista base es la estándar de Odoo
         (bloques 'address' e 'informations' activos). En las bases donde la vista
         fue reescrita a mano esos anclas no existen; por eso este template se
         desactiva automáticamente allí mediante _desactivar_report_std_sin_anclas()
         (ver <function> más abajo), evitando el error de carga por xpath no hallado. -->
    <template id="report_saleorder_document_inherit_localizacion_std"
              inherit_id="sale.report_saleorder_document" active="False">

        <!-- Vaciar el bloque address para que no aparezca en el encabezado -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address"/>
        </xpath>

        <!-- Reemplazar el bloque "Cliente:" inline (agregado por arsante)
             por una tabla organizada con los datos del cliente -->
        <xpath expr="//div[@id='informations']/preceding-sibling::div[1]" position="replace">
            <div class="row mt-4 mb-2">
                <div class="col-12">
                    <strong>Cliente:</strong>
                    <table class="table table-sm " style="font-size:10px;">
                        <thead class="bg-light">
                            <tr>
                                <th class="text-start">Nombre</th>
                                <th class="text-start">Dirección</th>
                                <th class="text-start">Ciudad</th>
                                <th class="text-start">Estado</th>
                                <th class="text-start">País</th>
                                <th class="text-start">RUT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span t-field="doc.partner_id.name"/></td>
                                <td>
                                    <span t-field="doc.partner_id.street"/>
                                    <t t-if="doc.partner_id.street2">
                                        , <span t-field="doc.partner_id.street2"/>
                                    </t>
                                </td>
                                <td><span t-field="doc.partner_id.city"/></td>
                                <td><span t-field="doc.partner_id.state_id"/></td>
                                <td><span t-field="doc.partner_id.country_id"/></td>
                                <td>
                                    <span t-if="doc.partner_id.vat"
                                          t-field="doc.partner_id.vat"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </xpath>

    </template>

    <!-- Reemplazar "Untaxed Amount" por "Monto Neto" en el resumen de totales -->
    <template id="document_tax_totals_inherit_localizacion"
              inherit_id="account.document_tax_totals">
        <xpath expr="//tr[contains(@class,'o_subtotal')]/td[1]/strong" position="replace">
            <strong t-if="subtotal['name'] == 'Untaxed Amount'">Monto Neto</strong>
            <strong t-else="" t-esc="subtotal['name']"/>
        </xpath>
    </template>

</odoo>
